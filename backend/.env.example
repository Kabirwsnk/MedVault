# ==============================================================================
# MedVault Backend Environment Variables
# ==============================================================================

# Database Connection (Neon, Supabase, Render PostgreSQL, Railway PostgreSQL)
# Both postgresql:// and postgres:// formats are supported.
# Examples:
# Neon / Supabase: postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Render / Railway: postgresql://postgres:password@postgres.render.com:5432/medvault
DATABASE_URL=postgresql+psycopg2://medvault_user:change-me@localhost:5432/medvault

# Security / Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
PROTECT_PATIENT_ENROLLMENT=true

# Redis / Rate Limiting (Upstash Redis or Managed Redis)
# For local memory: memory://
# For Upstash / Managed: rediss://default:password@your-endpoint.upstash.io:6379
# (Or set REDIS_URL and it will be picked up automatically)
RATE_LIMIT_STORAGE_URI=memory://

# Database Connection Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Clinical Inventory Alert Thresholds
LOW_STOCK_THRESHOLD=20
CRITICAL_STOCK_THRESHOLD=10

# Optional AI Assistant (OpenAI or Gemini compatibility layer)
OPENAI_API_KEY=

# Allowed CORS Origins (comma-separated list)
# Note: Vercel (*.vercel.app) and Netlify (*.netlify.app) are automatically permitted.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000
